# Caddy gets and renews the Let's Encrypt certificates by itself.
# No request is logged anywhere: not as access logs, not in proxy or TLS errors (they carry addresses and headers).
{
	log default {
		output stderr
		exclude http.log.access http.log.error http.stdlib http.handlers.reverse_proxy
	}
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			write 60s
			idle 2m
		}
	}
}

slopetanium.pw {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	request_body {
		max_size 64KB
	}
	reverse_proxy 127.0.0.1:8787 {
		header_up X-Real-IP {remote_host}
	}
	log {
		output discard
	}
}

www.slopetanium.pw {
	redir https://slopetanium.pw{uri} permanent
	log {
		output discard
	}
}
